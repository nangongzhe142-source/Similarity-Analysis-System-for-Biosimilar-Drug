    "AnalysisImageComparison": {
      "additionalProperties": false,
      "description": "The image-level observation, kept apart from the regulatory verdict.\n\n`driver_metric` names the single metric the outcome rests on. It is recorded\nbecause the other metrics are reported too and are not equivalent: measured\nover like-for-like and cross-analyte pairs, profile correlation separated them\ncompletely while SSIM and DTW did not separate them at all.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ImageComparisonOutcome"
        },
        "driverMetric": {
          "title": "Drivermetric",
          "type": "string"
        },
        "driverValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drivervalue"
        },
        "consistentThreshold": {
          "title": "Consistentthreshold",
          "type": "number"
        },
        "differenceThreshold": {
          "title": "Differencethreshold",
          "type": "number"
        },
        "thresholdKind": {
          "$ref": "#/$defs/ThresholdKind"
        },
        "nonDiscriminatingMetrics": {
          "items": {
            "type": "string"
          },
          "title": "Nondiscriminatingmetrics",
          "type": "array"
        },
        "rationale": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "required": [
        "outcome",
        "driverMetric",
        "consistentThreshold",
        "differenceThreshold",
        "thresholdKind",
        "nonDiscriminatingMetrics",
        "rationale"
      ],
      "title": "AnalysisImageComparison",
