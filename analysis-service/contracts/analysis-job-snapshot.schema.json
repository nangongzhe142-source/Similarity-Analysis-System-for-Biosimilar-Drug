    "ThresholdKind": {
      "description": "What a numeric cut-off is entitled to decide.\n\n`ALGORITHM_QUALITY_GATE` marks a value chosen so an algorithm can operate —\nit may gate whether a measurement is usable, and nothing else.\n`SIMILARITY_BOUNDARY` marks a limit that decides biosimilarity, which may only\ncome from the workbook or from a validated method. The distinction is carried\nin the contract so that a reader cannot mistake one for the other.",
      "enum": [
        "algorithmQualityGate",
        "similarityBoundary"
      ],
      "title": "ThresholdKind",
      "type": "string"
    }
