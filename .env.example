# OpenAI-compatible chat-completions endpoint. Leave blank to use the local evidence-only summary.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# UniDec CLI hard timeout. Valid range: 10-3600 seconds.
UNIDEC_TIMEOUT_SECONDS=600

# Unified external-engine timeout. Overrides UNIDEC_TIMEOUT_SECONDS when set.
EXTERNAL_ENGINE_TIMEOUT_SECONDS=600

# Optional explicit executable locations. BioCompare never downloads tools silently.
# Native headless core (unidec.exe <config>), not the GUI console launcher.
UNIDEC_BIN=
OPENMS_BIN_DIR=
FLASHDECONV_BIN=
SAGE_BIN=
DOTNET_BIN=
METAMORPHEUS_CMD=
METAMORPHEUS_RELEASE_VERSION=1.1.7
HAPPYTOOLS_ROOT=
KOJAK_BIN=
JAVA_BIN=
XISEARCH_JAR=
FRAGPIPE_BIN=

# Optional ASCII-only staging directory for OpenMS on Windows.
EXTERNAL_ENGINE_WORK_ROOT=
RSCRIPT_BIN=
R_LIBS_USER=
RETICULATE_PYTHON=
GLYCRESOFT_BIN=
CALCULATION_TASK_ROOT=
CALCULATION_WORKERS=2

# Project-isolated local UniDec / FragPipe task service.
# LOCAL_ENGINE_TASK_ROOT defaults to .runtime/local-engine-tasks.
LOCAL_ENGINE_TASK_ROOT=
# Number of simultaneous local engine processes (1-8).
LOCAL_ENGINE_WORKERS=2
# Per-process timeout in seconds (10-86400; task parameters may lower/override it).
LOCAL_ENGINE_TIMEOUT_SECONDS=7200
